# Copy to .env and fill in. Never commit .env.
# Groq (free, no card): https://console.groq.com/keys
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
# Used automatically if Groq retires or rejects LLM_MODEL.
LLM_FALLBACK_MODEL=openai/gpt-oss-20b
# Optional: seconds per request (10) and per chat step including retries (20).
# LLM_TIMEOUT=10
# LLM_TIME_BUDGET=20
# Backup: DeepSeek
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

SECRET_KEY=
DB_PATH=chatbot.db

# Optional: hosted database (Plan A). Leave empty to use the local SQLite file.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
